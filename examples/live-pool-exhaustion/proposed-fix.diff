+
+
+def test_risk_score_call_does_not_hold_a_db_connection(app_module, client, monkeypatch):
+    # RCA: ed3be52 called the slow card-gateway risk API while holding a pooled connection,
+    # pinning the pool at its limit and timing out every other /charge.
+    _fake_gateway(app_module, monkeypatch)
+    held = []
+
+    def risk_score(user, amount):
+        held.append(app_module.engine.pool.checkedout())
+        return 10
+
+    monkeypatch.setattr(app_module.gateway, "risk_score", risk_score)
+    r = client.post("/charge", json={"user_id": "u2", "card_token": "tok_visa", "amount_cents": 500})
+    assert r.status_code == 200
+    assert held == [0]
+
+
+def test_risk_score_is_stored_only_on_the_new_payment(app_module, client, monkeypatch):
+    from sqlalchemy import select
+
+    for score in (11, 22):
+        _fake_gateway(app_module, monkeypatch, score=score)
+        r = client.post("/charge", json={"user_id": "u3", "card_token": "tok_visa", "amount_cents": 500})
+        assert r.status_code == 200
+    p = app_module.payments
+    with app_module.engine.connect() as conn:
+        scores = conn.execute(select(p.c.risk_score).where(p.c.user_id == "u3").order_by(p.c.id)).scalars().all()
+    assert scores == [11, 22]
